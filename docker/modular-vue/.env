# docker-compose env

# xxl-boot, api
XXL_BOOT_API_PORT=8090
XXL_BOOT_API_CONTEXT_PATH=/

# xxl-boot, ui
XXL_BOOT_UI_PORT=3000

# xxl-boot, database
MYSQL_ROOT_PASSWORD=root_pwd
MYSQL_PATH=/Users/admin/program/docker/instance/mysql

# xxl-boot, redis
REDIS_PASSWORD=
REDIS_PATH=/Users/admin/program/docker/instance/redis