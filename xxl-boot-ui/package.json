{
  "name": "XXL-BOOT",
  "version": "2.1.0-SNAPSHOT",
  "description": "XXL-BOOT | 快速开发平台",
  "repository": "git@github.com:xuxueli/xxl-boot.git",
  "author": "xuxueli",
  "license": "GPL",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:prod": "vue-tsc --noEmit --skipLibCheck && vite build",
    "build:stage": "vue-tsc --noEmit --skipLibCheck && vite build --mode staging",
    "type-check": "vue-tsc --noEmit --skipLibCheck",
    "lint": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss}\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@vueup/vue-quill": "1.5.5",
    "@vueuse/core": "14.4.0",
    "axios": "1.19.0",
    "clipboard": "2.0.11",
    "echarts": "6.1.0",
    "element-plus": "2.14.4",
    "file-saver": "2.0.5",
    "fuse.js": "7.5.0",
    "js-beautify": "2.0.3",
    "js-cookie": "3.0.8",
    "nprogress": "0.2.0",
    "pinia": "4.0.2",
    "vue": "3.5.41",
    "vue-router": "5.2.0",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/file-saver": "2.0.7",
    "@types/js-beautify": "1.14.3",
    "@types/js-cookie": "3.0.6",
    "@types/node": "26.2.0",
    "@types/nprogress": "0.2.3",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "fast-glob": "3.3.3",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "sass-embedded": "1.100.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-setup-extend-plus": "1.0.1",
    "vite": "8.2.1",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-svg-icons": "2.0.1",
    "vue-tsc": "3.3.9"
  },
  "overrides": {
    "quill": "2.0.3"
  }
}
