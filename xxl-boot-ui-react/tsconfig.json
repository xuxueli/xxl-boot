{
  /**
   * 应用代码 TypeScript 配置（tsconfig.json）
   * 职责：配置 React 应用源码（src 目录）的类型检查与编译选项，供 IDE 与 tsc 使用；
   *       通过 references 关联 Node 侧构建配置（tsconfig.node.json），使 vite.config.ts 获得独立类型检查。
   */
  "compilerOptions": {
    "target": "ES2022",               /* 编译目标：ES2022（现代浏览器） */
    "module": "ESNext",               /* 模块系统：ESNext，打包交由 Vite 处理 */
    "moduleResolution": "bundler",    /* 模块解析策略：bundler（对齐 Vite 的解析行为） */
    "jsx": "react-jsx",               /* JSX 编译：自动运行时（无需手动 import React） */
    "strict": true,                   /* 严格模式全开（含 noImplicitAny、strictNullChecks 等） */
    "esModuleInterop": true,          /* 允许对 CommonJS 模块使用默认导入 */
    "skipLibCheck": true,             /* 跳过 node_modules 声明文件检查，提升编译速度 */
    "isolatedModules": true,          /* 单文件独立编译（对齐 esbuild 的转译约束） */
    "resolveJsonModule": true,        /* 允许导入 JSON 模块 */
    "useDefineForClassFields": true,  /* 对齐原生 class 字段语义 */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],               /* 路径别名 @ → src 目录 */
      "~/*": ["./*"]                  /* 路径别名 ~ → 项目根目录 */
    },
    "types": ["vite/client"],         /* 注入 Vite 环境变量类型 */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true                    /* 仅做类型检查，不产出编译文件（由 Vite/esbuild 负责构建） */
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
