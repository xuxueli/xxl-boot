{
  "name": "XXL-BOOT-REACT",
  "version": "2.1.0-SNAPSHOT",
  "description": "XXL-BOOT | 快速开发平台 (React 版)",
  "author": "xuxueli",
  "license": "GPL",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:prod": "tsc --noEmit --skipLibCheck && vite build",
    "build:stage": "tsc --noEmit --skipLibCheck && vite build --mode staging",
    "type-check": "tsc --noEmit --skipLibCheck",
    "lint": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "antd": "5.29.3",
    "axios": "1.19.0",
    "clipboard": "2.0.11",
    "echarts": "6.1.0",
    "file-saver": "2.0.5",
    "fuse.js": "7.5.0",
    "js-beautify": "2.0.3",
    "js-cookie": "3.0.8",
    "nprogress": "0.2.0",
    "react": "18.3.1",
    "react-activation": "0.13.4",
    "react-dom": "18.3.1",
    "react-quill-new": "3.8.3",
    "react-router-dom": "7.18.2",
    "react-transition-group": "4.4.5",
    "screenfull": "6.0.2",
    "sortablejs": "1.15.7",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/file-saver": "2.0.7",
    "@types/js-beautify": "1.14.3",
    "@types/js-cookie": "3.0.6",
    "@types/node": "26.2.0",
    "@types/nprogress": "0.2.3",
    "@types/react": "18.3.14",
    "@types/react-dom": "18.3.5",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fast-glob": "^3.3.3",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "sass-embedded": "1.100.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-svg-icons": "2.0.1"
  }
}
